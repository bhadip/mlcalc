# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=MLCalc
DEBUG=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── Database ──────────────────────────────────────────────────────────────────
DB_NAME=mlcalc
DB_USER=mlcalc
DB_PASSWORD=change-me-db-password

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mlcalc.prasanti.com/api/v1/auth/google/callback

# ─── Microsoft OAuth ───────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=https://mlcalc.prasanti.com/api/v1/auth/microsoft/callback

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://mlcalc.prasanti.com,http://localhost:3000

# ─── OCR ───────────────────────────────────────────────────────────────────────
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_GPU=false
MAX_UPLOAD_SIZE_MB=10

# ─── Broker Defaults ──────────────────────────────────────────────────────────
DEFAULT_STOP_OUT_PERCENT=50.0
DEFAULT_MARGIN_CALL_PERCENT=100.0
DEFAULT_LEVERAGE=100

# ─── Telegram (optional notifications) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
